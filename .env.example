# Copy this file to .env and adjust values for your deployment.
# Never commit real credentials or private URLs.

KOMBU_ENVIRONMENT=development
KOMBU_LOG_LEVEL=INFO
KOMBU_API_PREFIX=/api/v1
KOMBU_PUBLIC_WEB_URL=http://localhost:5173
KOMBU_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Local development defaults to SQLite. For production, point this at your own
# PostgreSQL-compatible service, for example:
# KOMBU_DATABASE_URL=postgresql+psycopg://kombu:kombu_change_me@db:5432/kombu
KOMBU_DATABASE_URL=sqlite:///./var/kombu.db

# Optional feature flags. These placeholders intentionally avoid vendor keys.
KOMBU_AI_FEATURES_ENABLED=false
KOMBU_SCANNER_UPLOAD_DIR=var/scans
KOMBU_RECIPE_IMPORT_DIR=var/imports

# Frontend server-side API target. In Compose this should usually be
# http://api:8000. In local development it is usually http://localhost:8000.
KOMBU_API_BASE_URL=http://localhost:8000
