{
  "name": "kombu-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host 0.0.0.0",
    "format": "biome format --write app react-router.config.ts vite.config.ts tsconfig.json package.json biome.json",
    "generate:api": "openapi-typescript ../openapi.json -o app/lib/api/schema.d.ts && biome format --write app/lib/api/schema.d.ts",
    "lint": "biome check app react-router.config.ts vite.config.ts tsconfig.json package.json biome.json components.json",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "^7.6.3",
    "@react-router/serve": "^7.6.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.28",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "radix-ui": "^1.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@react-router/dev": "^7.6.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "packageManager": "pnpm@11.7.0"
}
