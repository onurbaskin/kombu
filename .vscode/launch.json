{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kombu API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Kombu UI",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --dir ui dev"
    }
  ]
}
