[Unit]
Description=Kombu FastAPI service
After=kombu-db.service
Requires=kombu-db.service

[Container]
Image=localhost/kombu-api:latest
ContainerName=kombu-api
Network=kombu.network
EnvironmentFile=%h/.config/kombu/kombu.env
Volume=%h/kombu/var:/app/var:Z
Exec=/bin/sh -c "uv run --no-dev alembic -c api/alembic.ini upgrade head && exec uv run --no-dev uvicorn api.app.main:app --host 0.0.0.0 --port 8000"
HealthCmd=/app/.venv/bin/python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
HealthInterval=30s

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
