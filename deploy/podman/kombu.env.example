POSTGRES_DB=kombu
POSTGRES_USER=kombu
POSTGRES_PASSWORD=change_me_before_use
KOMBU_ENVIRONMENT=production
KOMBU_API_PREFIX=/api/v1
KOMBU_PUBLIC_WEB_URL=https://kombu.example.com
KOMBU_CORS_ORIGINS=https://kombu.example.com
KOMBU_DATABASE_URL=postgresql+psycopg://kombu:change_me_before_use@kombu-db:5432/kombu
KOMBU_AI_FEATURES_ENABLED=false
KOMBU_API_BASE_URL=http://kombu-api:8000
KOMBU_WORKER_POLL_SECONDS=5
KOMBU_CACHE_URL=
KOMBU_BLOB_STORAGE_BACKEND=filesystem
KOMBU_BLOB_STORAGE_ROOT=/app/var/blobs
